# =============================================================================
#  Vanvy Emby Suite · 环境配置模板
#  ---------------------------------------------------------------------------
#  用法：
#    1. 复制本文件为 vanvy.env
#         cp vanvy.env.example vanvy.env
#    2. 按需填写下面的值（不填 = 该功能自动降级/关闭）
#    3. install-ves.sh 会自动读取 vanvy.env
#
#  ⚠️  vanvy.env 已被 .gitignore 忽略，绝不会进入 git / 分发包。
#      分发时只带 vanvy.env.example（本文件，全部为占位符）。
#
#  所有变量都可以在部署时由 install-ves.sh 交互式询问覆盖。
# =============================================================================

# ─────────────────────────────────────────────────────────────
#  ① 目标环境
# ─────────────────────────────────────────────────────────────
# 部署目标 Docker 宿主机（用于远程部署脚本 ves_deploy.sh；留空=本机 docker）
# 格式: user@host   例: root@192.168.1.10
VANVY_DEPLOY_HOST=""
# SSH 密码（仅 ves_deploy.sh 使用；推荐改用 SSH 密钥留空此项）
VANVY_DEPLOY_PASS=""
# 远端暂存目录
VANVY_DEPLOY_DEST="/tmp/ves-build"

# ─────────────────────────────────────────────────────────────
#  ② 分发域名（本地/私有部署用；公开版请留空）
# ─────────────────────────────────────────────────────────────
# 你自己的 HTTPS 分发域名（用于图片代理等）。留空 = 关闭图片代理
VANVY_PUBLIC_DOMAIN=""
# 安装引导页（图文教程）地址。留空 = 自动用 https://<分发域名>/mockup/setup-guide/
# 也可在部署时用 --doc-url <网址> 临时指定；都留空则提示看随包文档 docs/INSTALL.md
VANVY_DOC_URL=""
# 内网备用分发地址（可选）
VANVY_LAN_SOURCE=""

# ─────────────────────────────────────────────────────────────
#  ③ JAV 增强（可选后端依赖）
#     不填 = 该子功能自动降级，不影响其它模块
# ─────────────────────────────────────────────────────────────
# MetaTube 服务地址（提供 JAV 元数据：番号/演员/标签/发行日期）
# 例: http://192.168.1.10:28080
VANVY_METATUBE_BASE=""
# AVDB 本地引擎地址（提供 JavDB 搜索/短评/图片解码）
VANVY_AVDB_BASE=""
# AVDB API Key（形如 X-API-Key 头）
VANVY_AVDB_KEY=""

# ── TMDB API Key（可选）────────────────────────────────────
# 用途：详情页「资料增强」（剧照 / 预告片 / 更多类似 / 演员）。
#   ⚠️ **请填你自己申请的 Key**，不要共用别人的（有调用频率限制，也会影响对方账号）。
#   免费申请：https://www.themoviedb.org/settings/api
#   配好后由「连接器」服务端持有 Key 并代为请求 → 外网环境也能用。
#   留空 = 不做 TMDB 增强（页面仍显示 Emby 本地数据）。
VANVY_TMDB_KEY=""
# ── 演员名映射（可选）────────────────────────────────────────
# 本地 Emby 演员名 → JavDB 可用名（简/繁/日文不一致时用）
# 写法：JSON。值可以是字符串或数组，数组表示“依次尝试”
#   VANVY_ACTOR_ALIAS='{"弥生美月":"弥生みづき","三上悠亚":["三上悠亜","三上悠亞"]}'
# 留空 = 全自动（搜演员 → 官方名+别名 → 试搜选命中最高的）
VANVY_ACTOR_ALIAS=""

# ── 二期增强开关（选填）─────────────────────────
# 整体开关：VANVY_P2=off 则全部关闭
# 单项（on/off）：VANVY_P2_SORT / VANVY_P2_CASTMENU / VANVY_P2_MORE /
#   VANVY_P2_SERIESWALL / VANVY_P2_MEDIAINFO / VANVY_P2_HEADER /
#   VANVY_P2_SERIESLOGO / VANVY_P2_EXTSITES / VANVY_P2_HIDEPATH
# 文字徽标：auto（默认，无徽标才用）/ always / never
VANVY_P2_TEXTLOGO=""
# 顶栏样式：solid（实心）/ clear（透明）/ glass（毛玻璃，默认）
VANVY_P2_HEADERMODE=""
# 隐藏真实路径（默认开，避免暴露内网地址与网盘目录）
VANVY_P2_HIDEPATH=""

# 图片代理地址（用于把 JavDB 图床图片转到可访问的 CDN）
# 留空 = 直接使用原始图片地址（部分图床可能不可达）
# 两种来源：① 你自己已部署的图片代理（如 https://你的域名/vdimg）
#           ② 用 VES 自带的 components/imgproxy 在本机一键部署（见下方 VANVY_PROXY_*）
VANVY_IMG_PROXY=""

# ── 图片代理·本机部署参数（选填；部署时交互向导也会问）───────
# 出网代理（HTTP/SOCKS5），多个用逗号分隔；留空=直连图床
# 例: socks5h://用户:密码@10.0.0.5:1080,http://user:pass@proxy:8080
VANVY_PROXY_URL=""
# 走代理范围: auto（仅墙外域名，推荐）| all（全部）| none（从不）
VANVY_PROXY_MODE=""
# 图片代理监听端口（默认 18098）
VANVY_IMG_PORT=""

# ─────────────────────────────────────────────────────────────
#  ④ 仅供本仓库开发者使用（普通用户忽略）
# ─────────────────────────────────────────────────────────────
# 开发机 UNRAID 地址（scripts/ves_deploy.sh 一键部署用）
VANVY_DEV_UNRAID=""
VANVY_DEV_UNRAID_PASS=""
# GitHub 仓库（scripts/sync_github.sh 用）
VANVY_GH_REPO=""

# ── 运维通知（可选）：部署守护告警推送 ──
# Telegram Bot Token / Chat ID（留空则不发通知）
VANVY_TG_TOKEN=""
VANVY_TG_CHAT=""
